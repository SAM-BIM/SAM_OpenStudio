<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\benchmark\SAM.Analytical.OpenStudio.InputReadBack\SAM.Analytical.OpenStudio.InputReadBack.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="SAM.Core"><HintPath>..\..\..\..\..\SAM\build\SAM.Core.dll</HintPath></Reference>
    <Reference Include="SAM.Geometry"><HintPath>..\..\..\..\..\SAM\build\SAM.Geometry.dll</HintPath></Reference>
    <Reference Include="SAM.Analytical"><HintPath>..\..\..\..\..\SAM\build\SAM.Analytical.dll</HintPath></Reference>
    <Reference Include="SAM.Architectural"><HintPath>..\..\..\..\..\SAM\build\SAM.Architectural.dll</HintPath></Reference>
    <Reference Include="SAM.Weather"><HintPath>..\..\..\..\..\SAM\build\SAM.Weather.dll</HintPath></Reference>
  </ItemGroup>
</Project>
