<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SAM.Analytical.OpenStudio.InputReadBack</RootNamespace>
    <IsPackable>false</IsPackable>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!--
    S09 OpenStudio native-input read-back (SAM documentation/SIMULATION_INPUT_MAPPING_S07.md).

    Independence (S07 section 3): this library references neither SAM.Analytical.OpenStudio nor the OpenStudio SDK. It
    reads the saved OSM and the translated IDF as text, field by field, and derives every expected value from the frozen
    SAM model.

    Reuse, not copies (both live in SAM_Tas and are cloned as a sibling, as SAM is):
    - the S08 COM-free evaluation core (outcomes, S07 tolerances, rank gate, OD-G1..G3 rules), by project reference;
    - the S08 SAM-intent builder ReadBackExpected.cs (raw SAM parameters, geometry, T-FRAME split, profiles), linked,
      so both engines are checked against one derivation of SAM intent.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\..\SAM_Tas\benchmark\SAM.Analytical.InputEquivalence\SAM.Analytical.InputEquivalence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\SAM_Tas\SAM_Tas\SAM.Analytical.Tas.DirectT3D.Validation\ReadBack\ReadBackExpected.cs" Link="Linked\ReadBackExpected.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SAM.Core">
      <HintPath>..\..\..\SAM\build\SAM.Core.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Geometry">
      <HintPath>..\..\..\SAM\build\SAM.Geometry.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Analytical">
      <HintPath>..\..\..\SAM\build\SAM.Analytical.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Architectural">
      <HintPath>..\..\..\SAM\build\SAM.Architectural.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Weather">
      <HintPath>..\..\..\SAM\build\SAM.Weather.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
