<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SAM.Analytical.OpenStudio.ResultsReadBack.Cli</RootNamespace>
    <AssemblyName>os-results-readback</AssemblyName>
    <IsPackable>false</IsPackable>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!--
    S11 harness. Only the subject step (and the Sensible-substitution negative, which re-maps mutated objects) runs
    production code: the B1a producer (benchmark-openstudio's Modify.ToBenchmark) for the closure check, the production
    report-key naming and the SAM_UI/Grasshopper import Modify.AddResults. The read and compare steps run in separate
    processes and use only the SAM.Analytical.OpenStudio.ResultsReadBack library, which references none of it.
  -->

  <ItemGroup>
    <PackageReference Include="OpenStudio" Version="3.10.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SAM.Analytical.OpenStudio.InputReadBack.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SAM.Analytical.OpenStudio.ResultsReadBack\SAM.Analytical.OpenStudio.ResultsReadBack.csproj" />
    <ProjectReference Include="..\SAM.Analytical.OpenStudio.Benchmark\SAM.Analytical.OpenStudio.Benchmark.csproj" />
    <ProjectReference Include="..\..\SAM_OpenStudio\SAM.Core.OpenStudio\SAM.Core.OpenStudio.csproj" />
    <ProjectReference Include="..\..\SAM_OpenStudio\SAM.Geometry.OpenStudio\SAM.Geometry.OpenStudio.csproj" />
    <ProjectReference Include="..\..\SAM_OpenStudio\SAM.Analytical.OpenStudio\SAM.Analytical.OpenStudio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SAM.Analytical.Benchmark">
      <HintPath>..\..\..\SAM_Validation\build\SAM.Analytical.Benchmark.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Core">
      <HintPath>..\..\..\SAM\build\SAM.Core.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Geometry">
      <HintPath>..\..\..\SAM\build\SAM.Geometry.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Analytical">
      <HintPath>..\..\..\SAM\build\SAM.Analytical.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Architectural">
      <HintPath>..\..\..\SAM\build\SAM.Architectural.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Weather">
      <HintPath>..\..\..\SAM\build\SAM.Weather.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
