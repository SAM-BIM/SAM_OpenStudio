<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SAM.Analytical.OpenStudio.InputReadBack.Cli</RootNamespace>
    <AssemblyName>os-input-readback</AssemblyName>
    <IsPackable>false</IsPackable>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!--
    S09 harness. Only the export mode uses the SAM writer and the OpenStudio SDK (it converts a frozen fixture, saves the
    OSM and translates it to IDF). The read and compare modes run in separate processes and use only the
    SAM.Analytical.OpenStudio.InputReadBack library, which references neither.
  -->

  <ItemGroup>
    <PackageReference Include="OpenStudio" Version="3.10.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SAM.Analytical.OpenStudio.InputReadBack.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SAM.Analytical.OpenStudio.InputReadBack\SAM.Analytical.OpenStudio.InputReadBack.csproj" />
    <ProjectReference Include="..\..\SAM_OpenStudio\SAM.Core.OpenStudio\SAM.Core.OpenStudio.csproj" />
    <ProjectReference Include="..\..\SAM_OpenStudio\SAM.Geometry.OpenStudio\SAM.Geometry.OpenStudio.csproj" />
    <ProjectReference Include="..\..\SAM_OpenStudio\SAM.Analytical.OpenStudio\SAM.Analytical.OpenStudio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SAM.Core">
      <HintPath>..\..\..\SAM\build\SAM.Core.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Geometry">
      <HintPath>..\..\..\SAM\build\SAM.Geometry.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Analytical">
      <HintPath>..\..\..\SAM\build\SAM.Analytical.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Architectural">
      <HintPath>..\..\..\SAM\build\SAM.Architectural.dll</HintPath>
    </Reference>
    <Reference Include="SAM.Weather">
      <HintPath>..\..\..\SAM\build\SAM.Weather.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
